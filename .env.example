# Firebase 콘솔(https://console.firebase.google.com) > 프로젝트 설정 > 내 앱(웹)에서
# SDK 설정값을 복사해 .env 파일(이 파일과 같은 위치)에 실제 값으로 채워주세요.
# 방명록(Guestbook) 기능은 Realtime Database를 사용하므로,
# 콘솔의 Build > Realtime Database에서 데이터베이스를 먼저 생성해야 databaseURL이 발급됩니다.
VITE_APP_FIREBASE_API_KEY=
VITE_APP_FIREBASE_AUTH_DOMAIN=
VITE_APP_FIREBASE_DATABASE_URL=
VITE_APP_FIREBASE_PROJECT_ID=
VITE_APP_FIREBASE_STORAGE_BUCKET=
VITE_APP_FIREBASE_MESSAGING_SENDER_ID=
VITE_APP_FIREBASE_APP_ID=
